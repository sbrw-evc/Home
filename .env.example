# Версия образа ghcr.io/sbrw-evc/home
HOME_VERSION=1.0.0
# Порт страницы на хосте
HOME_PORT=8088
# Каталог data локального Nginx Proxy Manager (тот, что у NPM смонтирован как /data).
# Если локального NPM нет — оставьте как есть.
NPM_DATA_DIR=./npm-data

# Адрес OpenBao
BAO_ADDR=https://openbao.example.com:8200

# Вход: либо токен...
BAO_TOKEN=
# ...либо AppRole (рекомендуется)
BAO_ROLE_ID=
BAO_SECRET_ID=

# KV v2: секреты источников лежат в <BAO_KV_MOUNT>/<BAO_PATH_PREFIX>/<id источника> (ключи email, password)
BAO_KV_MOUNT=secret
BAO_PATH_PREFIX=npm-dashboard/sources
# Пароль администратора: ключ password в <BAO_KV_MOUNT>/<BAO_ADMIN_PATH>
BAO_ADMIN_PATH=npm-dashboard/admin
# BAO_NAMESPACE=
# BAO_SKIP_VERIFY=true   # для самоподписанного сертификата OpenBao

# Пароль администратора можно задать и здесь — тогда он важнее значения из OpenBao
# ADMIN_PASSWORD=
